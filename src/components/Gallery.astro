---
interface Img {
  src: string;
  alt: string;
  w?: number;
  h?: number;
}

import "../styles/gallery.css";
import lightboxScript from "../scripts/gallery-lightbox.js?url";

const { images = [] as Img[] } = Astro.props;
---

<section class="gallery" aria-label="Galerie d’illustrations">
  {images.map((img: Img, i: number) => (
    <button
      type="button"
      class="thumb"
      data-index={i}
      style={`--i:${i};`}
      aria-label={`Voir l’illustration en grand : ${img.alt}`}
    >
      <img
        src={img.src}
        alt={img.alt}
        loading={i < 3 ? "eager" : "lazy"}
        decoding="async"
        width={img.w ?? 800}
        height={img.h ?? 600}
        sizes="(min-width: 1200px) 360px, (min-width: 768px) 45vw, 92vw"
        fetchpriority={i === 0 ? "high" : "auto"}
      />
    </button>
  ))}
</section>

<!-- Lightbox -->
<dialog class="lightbox" id="lightbox" aria-label="Aperçu de l’illustration">
  <button class="close" aria-label="Fermer">×</button>
  <button class="prev" aria-label="Illustration précédente">‹</button>
  <figure class="stage">
    <img id="lb-img" alt="" />
    <figcaption id="lb-cap"></figcaption>
  </figure>
  <button class="next" aria-label="Illustration suivante">›</button>
</dialog>

<script type="module" src={lightboxScript}></script>
