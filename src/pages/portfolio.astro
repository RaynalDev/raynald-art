---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const description =
  "Découvrez le portfolio de Raynald Monta : illustrations éditoriales, character design et croquis en digital painting.";
---
<Base title="Portfolio | Raynald" description={description}>
  <Header />
  <main>
    <h2>Portfolio</h2>
    <p>Une sélection de mes illustrations et travaux sera bientôt disponible ici.</p>
  </main>
  <Footer />
</Base>
