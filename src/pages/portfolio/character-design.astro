---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";

// Liste des character design
const images = [
  { src: "/images/character-design/char1.jpg", alt: "Character 1" },
  { src: "/images/character-design/char2.jpg", alt: "Character 2" },
];
---
<Base title="Character Design | Raynald">
  <Header />
  <main>
    <!-- <h2 style="max-width:1200px;margin:1rem auto;padding:0 1rem;">Character Design</h2> -->
    <Gallery images={images} />
  </main>
  <Footer />
</Base>
