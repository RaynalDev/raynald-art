---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";

const description =
  "Illustrations de Raynald Monta : compositions narratives, scènes fantastiques et recherches colorées en digital painting.";

// Liste tes visuels (mets-les dans /public/images/illustrations/)
const images = [
  { src: "/images/illustrations/Free.png", alt: " \"Free\"" },
  { src: "/images/illustrations/Tuto_monthly_challenge.png", alt: "White Souls Day" },
  { src: "/images/illustrations/beware-the-whale.jpg", alt: "Beware" },
  { src: "/images/illustrations/BewareTheWale.jpg", alt: "Beware the Whale." },
  { src: "/images/illustrations/Cinderella-car.png", alt: "Cendrillon quitte le bal" },
  { src: "/images/illustrations/cinderella-swing.jpg", alt: "Balancing Cendrillon" },
  { src: "/images/illustrations/Innoncence.jpg", alt: " Innocence " },
  { src: "/images/illustrations/corny.jpg", alt: "Corny" },
  { src: "/images/illustrations/darkAngels.jpg", alt: "Dark Angels" },
  { src: "/images/illustrations/Flyaway.jpg", alt: "Fly Away" },
  { src: "/images/illustrations/oneLost.png", alt: "Une de perdue..." },
  { src: "/images/illustrations/Harpies.jpg", alt: "Harpies." },
  { src: "/images/illustrations/Looking-for-ourselves.jpg", alt: "Looking for Ourselves" },
  { src: "/images/illustrations/Moment.jpg", alt: "Moment." },
  { src: "/images/illustrations/pinocchio.jpg", alt: "Pinocchio" },

];

---
<Base
  title="Illustrations | Raynald"
  description={description}
  image="/images/illustrations/Free.png"
>
  <Header />
  <main>
    <Gallery images={images} />
  </main>
  <Footer />
</Base>
