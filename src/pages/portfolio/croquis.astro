---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";

// Liste des croquis (mets-les dans /public/images/croquis/)
const images = [

  { src: "/images/croquis/raynald-upper.jpg", alt: ""},
    { src: "/images/croquis/30min-study.jpg", alt: ""},
  { src: "/images/croquis/lianne.jpg", alt: ""},
  { src: "/images/croquis/onepieceback.jpg", alt: ""},
  { src: "/images/croquis/raynald-orange-wedge.jpg", alt: ""},
];
---
<Base title="Croquis | Raynald">
  <Header />
  <main>
    <!-- <h2 style="max-width:1200px;margin:1rem auto;padding:0 1rem;">Croquis</h2> -->
    <Gallery images={images} />
  </main>
  <Footer />
</Base>
