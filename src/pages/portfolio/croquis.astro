---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";

// Liste des croquis (mets-les dans /public/images/croquis/)
const images = [
  { src: "/images/croquis/sketch1.jpg", alt: "Croquis 1" },
  { src: "/images/croquis/sketch2.jpg", alt: "Croquis 2" },
];
---
<Base title="Croquis | Raynald">
  <Header />
  <main>
    <!-- <h2 style="max-width:1200px;margin:1rem auto;padding:0 1rem;">Croquis</h2> -->
    <Gallery images={images} />
  </main>
  <Footer />
</Base>
