---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";

const description =
  "Portraits numériques par Raynald Monta : visages expressifs, lumières contrastées et palettes vibrantes.";

// Liste des images de portraits (mets-les dans /public/images/portraits/)
const images = [
  { src: "/images/Portraits/Black.png", alt: "Black" },
  { src: "/images/Portraits/Red.png", alt: "Red" },
  { src: "/images/Portraits/thugLife.png", alt: "Thug Life" },
  { src: "/images/Portraits/morgane.jpg", alt: "Morgane" },
  { src: "/images/Portraits/raynald-jov5.jpg", alt: "Portrait aux couleurs vives avec touches fluorescentes." },
  { src: "/images/Portraits/ready.png", alt: "Ready" },
  { src: "/images/Portraits/Show-me-how.jpg", alt: "Show Me How" },
];
---
<Base
  title="Portraits | Raynald"
  description={description}
  image="/images/Portraits/Black.png"
>
  <Header />
  <main>
    <!-- <h2 style="max-width:1200px;margin:1rem auto;padding:0 1rem;">Portraits</h2> -->
    <Gallery images={images} />
  </main>
  <Footer />
</Base>
