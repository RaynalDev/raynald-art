---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Gallery from "../../components/Gallery.astro";

// Liste des images de portraits (mets-les dans /public/images/portraits/)
const images = [
  { src: "/images/Portraits/Black.png", alt: "Black / description 01" },
  { src: "/images/Portraits/Red.png", alt: "Titre / description 04" },
  { src: "/images/Portraits/thugLife.png", alt: "Titre / description 05" },
  { src: "/images/Portraits/morgane.jpg", alt : ""},
  { src: "/images/Portraits/raynald-jov5.jpg", alt : ""},
  { src: "/images/Portraits/ready.jpg", alt : ""},
  { src: "/images/Portraits/Show-me-how.jpg", alt : ""},
  { src: "/images/Portraits/Black.png", alt: "Black / description 01" },
];
---
<Base title="Portraits | Raynald">
  <Header />
  <main>
    <!-- <h2 style="max-width:1200px;margin:1rem auto;padding:0 1rem;">Portraits</h2> -->
    <Gallery images={images} />
  </main>
  <Footer />
</Base>
