---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const description =
  "Programme de mentorat en digital painting proposé par Raynald. Les informations détaillées arrivent prochainement.";
---
<Base title="Mentorat | Raynald" description={description} noindex={true}>
  <Header />
  <main>
    <h2>Mentorat</h2>
    <p>Informations sur mon accompagnement et mes cours en digital painting à venir.</p>
  </main>
  <Footer />
</Base>
